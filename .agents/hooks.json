{
  "scout-routing": {
    "PreToolUse": [
      {
        "matcher": "run_command|call_mcp_tool",
        "hooks": [
          {
            "type": "command",
            "command": "python F:\\Study\\Repos\\Homelab\\scripts\\scout-agy-hook.py -Event PreToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python F:\\Study\\Repos\\Homelab\\scripts\\scout-agy-hook.py -Event PostToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python F:\\Study\\Repos\\Homelab\\scripts\\scout-agy-hook.py -Event Stop",
        "timeout": 30
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python F:\\Study\\Repos\\Homelab\\scripts\\scout-agy-hook.py -Event PreInvocation",
        "timeout": 30
      }
    ]
  }
}
